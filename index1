<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kovai Studio Coonoor | Photography & Personalized Gifts</title>
    <!-- Tailwind CSS for modern styling -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- FontAwesome for clean icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Smooth scrolling for navigation */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

    <!-- Header / Navigation -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="bg-indigo-600 text-white p-2 rounded-lg">
                    <i class="fa-solid fa-camera-retro text-xl"></i>
                </div>
                <div>
                    <span class="text-xl font-bold tracking-tight text-slate-900 block">KOVAI STUDIO</span>
                    <span class="text-xs text-indigo-600 font-medium tracking-widest block uppercase -mt-1">Coonoor</span>
                </div>
            </div>
            <nav class="hidden md:flex space-x-8 font-medium">
                <a href="#home" class="text-slate-600 hover:text-indigo-600 transition">Home</a>
                <a href="#services" class="text-slate-600 hover:text-indigo-600 transition">Our Services</a>
                <a href="#about" class="text-slate-600 hover:text-indigo-600 transition">About Us</a>
                <a href="#contact" class="bg-indigo-600 text-white px-5 py-2 rounded-full hover:bg-indigo-700 transition shadow-sm">Book a Service</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="home" class="relative overflow-hidden bg-white pt-16 pb-24 lg:pt-24 lg:pb-32">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6 max-w-2xl">
                <span class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700">
                    <i class="fa-solid fa-star text-[10px]"></i> Capturing Memories, Crafting Gifts
                </span>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-tight">
                    Premium Photography & <span class="text-indigo-600">Customized Gifts</span> in Coonoor
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed">
                    From professional wedding shoots and bridal jewellery rentals to bespoke photo frames, customized mobile covers, and corporate merchandising. We bring your visions to life.
                </p>
                <div class="flex flex-wrap gap-4 pt-2">
                    <a href="#services" class="bg-slate-900 text-white px-8 py-3.5 rounded-xl font-semibold shadow-md hover:bg-slate-800 transition flex items-center gap-2">
                        Explore Services <i class="fa-solid fa-arrow-right text-sm"></i>
                    </a>
                    <a href="#contact" class="bg-white border-2 border-slate-200 text-slate-700 px-8 py-3.5 rounded-xl font-semibold hover:border-slate-300 hover:bg-slate-50 transition">
                        Get a Free Quote
                    </a>
                </div>
            </div>
            <!-- Decorative Visual Right Column -->
            <div class="relative hidden lg:block">
                <div class="absolute -top-12 -left-12 w-72 h-72 bg-indigo-100 rounded-full blur-3xl opacity-60"></div>
                <div class="absolute -bottom-12 -right-12 w-72 h-72 bg-emerald-100 rounded-full blur-3xl opacity-60"></div>
                <div class="relative bg-gradient-to-br from-indigo-50 to-slate-100 border border-slate-200 rounded-2xl p-8 shadow-xl grid grid-cols-2 gap-4">
                    <div class="space-y-4">
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
                            <i class="fa-solid fa-camera text-2xl text-indigo-500 mb-2"></i>
                            <h4 class="font-bold text-slate-900">Expert Shoots</h4>
                            <p class="text-xs text-slate-500 mt-1">Weddings, Kids & Events</p>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
                            <i class="fa-solid fa-gift text-2xl text-rose-400 mb-2"></i>
                            <h4 class="font-bold text-slate-900">Custom Gifts</h4>
                            <p class="text-xs text-slate-500 mt-1">Mugs, Shirts, Keychains</p>
                        </div>
                    </div>
                    <div class="space-y-4 pt-8">
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
                            <i class="fa-solid fa-gem text-2xl text-amber-500 mb-2"></i>
                            <h4 class="font-bold text-slate-900">Bridal Rentals</h4>
                            <p class="text-xs text-slate-500 mt-1">Premium Jewellery sets</p>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
                            <i class="fa-solid fa-print text-2xl text-emerald-500 mb-2"></i>
                            <h4 class="font-bold text-slate-900">Sublimation</h4>
                            <p class="text-xs text-slate-500 mt-1">High-quality printing</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-20 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">Our Comprehensive Services</h2>
                <p class="text-slate-600">Discover everything from beautiful photography options to highly customized gift printing tailored just for your needs.</p>
                
                <!-- Category Filters -->
                <div class="flex flex-wrap justify-center gap-2 pt-6">
                    <button onclick="filterServices('all')" id="btn-all" class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition bg-indigo-600 text-white shadow-sm">All Services</button>
                    <button onclick="filterServices('photo')" id="btn-photo" class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition bg-white text-slate-600 border border-slate-200 hover:bg-slate-50">Photography & Albums</button>
                    <button onclick="filterServices('print')" id="btn-print" class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition bg-white text-slate-600 border border-slate-200 hover:bg-slate-50">Custom Gifts & Printing</button>
                    <button onclick="filterServices('studio')" id="btn-studio" class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition bg-white text-slate-600 border border-slate-200 hover:bg-slate-50">Studio Specialities</button>
                </div>
            </div>

            <!-- Services Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="services-grid">
                
                <!-- Photography & Shoots -->
                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="photo">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-heart"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Wedding Shoot</h3>
                    <p class="text-slate-600 text-sm mb-6">Candid and traditional professional wedding photography capturing your most precious milestones beautifully.</p>
                    <button onclick="selectService('Wedding Shoot')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1 mt-auto">Book Shoot <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="photo">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-child"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Kids Shoot</h3>
                    <p class="text-slate-600 text-sm mb-6">Fun, creative, and patient portrait sessions structured specifically for children and toddlers.</p>
                    <button onclick="selectService('Kids Shoot')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Book Shoot <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="photo">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-book-open"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Wedding & Photo Album Making</h3>
                    <p class="text-slate-600 text-sm mb-6">Premium layout design paired with crystal clear high-definition album printing and sturdy cover binding.</p>
                    <button onclick="selectService('Wedding & Photo Album Making')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Inquire Design <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <!-- Custom Prints & Sublimation -->
                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-gift"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Customized Gifts</h3>
                    <p class="text-slate-600 text-sm mb-6">A curated selection of unique customized tokens, gift baskets, and personalized items for any occasion.</p>
                    <button onclick="selectService('Customized Gifts')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Order Custom <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-shirt"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">T-Shirt Printing</h3>
                    <p class="text-slate-600 text-sm mb-6">High-grade fabric sublimation ideal for custom fashion designs, birthdays, family events, or corporate uniforms.</p>
                    <button onclick="selectService('T-Shirt Printing')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Order Print <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-mug-hot"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Mug Printing</h3>
                    <p class="text-slate-600 text-sm mb-6">Excellent, dishwasher-safe photographic custom printing on premium ceramic mugs for home or gifts.</p>
                    <button onclick="selectService('Mug Printing')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Order Print <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-mobile-screen"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Mobile Cover Printing</h3>
                    <p class="text-slate-600 text-sm mb-6">Durable, high-definition photo phone cases tailored directly to your specific smartphone model.</p>
                    <button onclick="selectService('Mobile Cover Printing')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Order Print <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-key"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Key Chain Printing</h3>
                    <p class="text-slate-600 text-sm mb-6">Polished custom keychains in wooden, metal, or acrylic formats—perfect for small tokens or event favors.</p>
                    <button onclick="selectService('Key Chain Printing')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Order Print <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-mattress-pillow"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Pillow Cover Printing</h3>
                    <p class="text-slate-600 text-sm mb-6">Soft custom cushion and pillow covers printed beautifully with high-contrast family photographs or text.</p>
                    <button onclick="selectService('Pillow Cover Printing')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Order Print <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-calendar-days"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Customized Calendar</h3>
                    <p class="text-slate-600 text-sm mb-6">Personalized desktop or wall calendars featuring unique images chosen by you for every month of the year.</p>
                    <button onclick="selectService('Customized Calendar')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Order Print <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="print">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-pen-nib"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Logo Printing & Branding</h3>
                    <p class="text-slate-600 text-sm mb-6">Sharp, professional high-fidelity company logo reproduction across custom apparel, signage, and marketing gear.</p>
                    <button onclick="selectService('Logo Printing')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Inquire Branding <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <!-- Studio Specialities -->
                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="studio">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-gem"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Bridal Jewellery For Rent</h3>
                    <p class="text-slate-600 text-sm mb-6">Exquisite, curated bridal sets and traditional heavy wedding jewellery elements available for short-term rental.</p>
                    <button onclick="selectService('Bridal Jewellery Rental')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Check Selection <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="studio">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-ear-listen"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Gun Shot Ear Piercing</h3>
                    <p class="text-slate-600 text-sm mb-6">Safe, completely hygienic, and rapid precise piercing using industry-regulated gun shot equipment.</p>
                    <button onclick="selectService('Gun shot (Ear Piercing)')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Book Slot <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="studio">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-box-archive"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Photo Lamination Work</h3>
                    <p class="text-slate-600 text-sm mb-6">Preserve family legacy prints permanently with wood, gloss, or textured matte lamination finishes.</p>
                    <button onclick="selectService('Photo Lamination Work')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">Inquire Pricing <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <div class="service-card bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 hover:shadow-md transition" data-category="studio">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold mb-5"><i class="fa-solid fa-headphones"></i></div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Mobile Accessories</h3>
                    <p class="text-slate-600 text-sm mb-6">Explore our curated collection of standard device essentials, premium chargers, cables, and connectors in store.</p>
                    <button onclick="selectService('Mobile Accessories')" class="text-indigo-600 font-semibold text-sm hover:text-indigo-700 flex items-center gap-1">View In-Store <i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-20 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
            <h2 class="text-3xl font-bold text-slate-900">Why Choose Kovai Studio?</h2>
            <p class="text-slate-600 max-w-2xl mx-auto leading-relaxed">
                Based in the heart of Coonoor, Kovai Studio bridges classic photography with cutting-edge customization. Whether you are looking to book a professional shoot, source elegant rental items, or construct a tailored gift for a loved one, we ensure absolute care and precision every single step of the way.
            </p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-8 text-center">
                <div class="p-4 border border-slate-100 rounded-xl bg-slate-50">
                    <p class="text-3xl font-extrabold text-indigo-600">100%</p>
                    <p class="text-sm text-slate-500 font-medium mt-1">High Quality Print</p>
                </div>
                <div class="p-4 border border-slate-100 rounded-xl bg-slate-50">
                    <p class="text-3xl font-extrabold text-indigo-600">Safe</p>
                    <p class="text-sm text-slate-500 font-medium mt-1">Hygienic Piercing</p>
                </div>
                <div class="p-4 border border-slate-100 rounded-xl bg-slate-50">
                    <p class="text-3xl font-extrabold text-indigo-600">Premium</p>
                    <p class="text-sm text-slate-500 font-medium mt-1">Jewellery Selection</p>
                </div>
                <div class="p-4 border border-slate-100 rounded-xl bg-slate-50">
                    <p class="text-3xl font-extrabold text-indigo-600">Local</p>
                    <p class="text-sm text-slate-500 font-medium mt-1">Trusted in Coonoor</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Booking & Contact Section -->
    <section id="contact" class="py-20 bg-slate-900 text-white relative">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center space-y-3 mb-12">
                <h2 class="text-3xl font-bold tracking-tight">Place an Order / Booking Inquiry</h2>
                <p class="text-slate-400">Let us know what service you require and our team will get back to you with custom pricing immediately.</p>
            </div>
            
            <form id="inquiryForm" onsubmit="handleFormSubmit(event)" class="bg-white text-slate-800 p-8 rounded-2xl shadow-xl space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Your Name</label>
                        <input type="text" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Phone Number</label>
                        <input type="tel" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Select Service Interested In</label>
                    <select id="serviceDropdown" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white transition">
                        <option value="" disabled selected>-- Choose a Service --</option>
                        <optgroup label="Photography & Shoots">
                            <option value="Wedding Shoot">Wedding Shoot</option>
                            <option value="Kids Shoot">Kids Shoot</option>
                            <option value="Wedding & Photo Album Making">Wedding & Photo Album Making</option>
                        </optgroup>
                        <optgroup label="Custom Gifts & Printing">
                            <option value="Customized Gifts">Customized Gifts</option>
                            <option value="T-Shirt Printing">T-Shirt Printing</option>
                            <option value="Mug Printing">Mug Printing</option>
                            <option value="Mobile Cover Printing">Mobile Cover Printing</option>
                            <option value="Key Chain Printing">Key Chain Printing</option>
                            <option value="Pillow Cover Printing">Pillow Cover Printing</option>
                            <option value="Customized Calendar">Customized Calendar</option>
                            <option value="Logo Printing">Logo Printing & Corporate Branding</option>
                        </optgroup>
                        <optgroup label="Studio Specialities">
                            <option value="Bridal Jewellery Rental">Bridal Jewellery For Rent</option>
                            <option value="Gun shot (Ear Piercing)">Gun shot (Ear Piercing)</option>
                            <option value="Photo Lamination Work">Photo Lamination Work</option>
                            <option value="Mobile Accessories">Mobile Accessories Selection</option>
                        </optgroup>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Message / Custom Requirements (Optional)</label>
                    <textarea rows="4" placeholder="Mention size details, dates, or custom text variations..." class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none transition"></textarea>
                </div>

                <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-4 rounded-xl shadow-md hover:bg-indigo-700 transition">
                    Submit Order Request
                </button>
            </form>

            <div id="successMessage" class="hidden mt-6 bg-emerald-500 text-white p-4 rounded-xl text-center font-semibold flex items-center justify-center gap-2">
