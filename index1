    <!-- Interactive JavaScript Logic -->
    <script>
        // Filters services cleanly inside the catalog grid grid viewport view
        function filterServices(category) {
            const cards = document.querySelectorAll('.service-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // Handle updating selected layout states across buttons
            buttons.forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
                btn.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
            });
            
            const selectedButton = document.getElementById(`btn-${category}`);
            selectedButton.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
            selectedButton.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');

            // Handle rendering transition cycles for targeted catalog entries
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Connect quick action buttons across product arrays directly into entry dropdowns
        function selectService(serviceName) {
            const dropdown = document.getElementById('serviceDropdown');
            dropdown.value = serviceName;
            
            // Smoothly navigate the user directly into entry coordinates
            document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
        }

        // Handle processing client actions dynamically
        function handleFormSubmit(event) {
            event.preventDefault();
            const successBox = document.getElementById('successMessage');
            successBox.classList.remove('hidden');
            event.target.reset();
            
            // Clean active user text fields after delay timeout handles loop
            setTimeout(() => {
                successBox.classList.add('hidden');
            }, 5000);
        }
    </script>
</body>
